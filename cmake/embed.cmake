# Turns the manuals into C++ byte arrays (the built-in manual).
# cmake -DOUT=<file.cpp> -DFILES="<file>;<symbol>;<file>;<symbol>..." -P embed.cmake
set(out "// Generated by cmake/embed.cmake\n")
list(LENGTH FILES n)
math(EXPR last "${n} - 1")
foreach(i RANGE 0 ${last} 2)
  math(EXPR j "${i} + 1")
  list(GET FILES ${i} in)
  list(GET FILES ${j} name)
  file(READ "${in}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1,\n" hex "${hex}")
  string(APPEND out "extern const unsigned char ${name}[] = {\n${hex}0x00};\n")
  string(APPEND out "extern const unsigned long ${name}_size = sizeof(${name}) - 1;\n")
endforeach()
file(WRITE "${OUT}" "${out}")
